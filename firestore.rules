rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'roohpro1@gmail.com' ||
        request.auth.token.email == 'roohjoop@gmail.com' ||
        request.auth.token.email == 'roohpro9@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for Job/Seeker posts
    function isValidJobPost(data) {
      return data.id is string && data.id.size() <= 128
        && data.type in ['job', 'seeker']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300;
    }

    // Validation for User Profiles
    function isValidUserProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    // Validation for Comments
    function isValidComment(data) {
      return data.id is string && data.id.size() <= 128
        && data.postId is string && data.postId.size() <= 128
        && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
        && data.userName is string && data.userName.size() <= 100;
    }

    // Validation for Support Tickets
    function isValidSupportTicket(data) {
      return data.id is string && data.id.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 120
        && data.status in ['open', 'replied', 'closed'];
    }

    // Posts Collection: Jobs and Seeker Listings
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isValidId(postId) && isValidJobPost(incoming());
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUserProfile(incoming());
      allow delete: if isAdmin();
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isValidComment(incoming());
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid));
    }

    // Support Tickets Collection (Email Isolation Enforcement)
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && isValidId(ticketId) && (
        resource.data.userEmail == request.auth.token.email || isAdmin()
      );
      allow create, update: if isValidId(ticketId);
      allow delete: if isAdmin();
    }

    // Ad Reports Collection
    match /ad_reports/{reportId} {
      allow read, create, update: if isValidId(reportId);
      allow delete: if isAdmin();
    }

    // Subscribers & Email Collection for Central Cloudflare D1 Synchronization
    match /jop_subscribers/{subId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /subscribers/{subId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Admins and Developer Operations
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /policy_approvals/{approvalId} {
      allow read, write: if true;
    }

    match /developer_banners/{bannerId} {
      allow read, write: if true;
    }

    // Developer Credentials Collection for portal authentication
    match /developer_auth/{authId} {
      allow read, write: if true;
    }

    // FCM Web Push Tokens Collection
    match /fcmTokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Test connection doc for client health check
    match /test/connection {
      allow read: if true;
    }
  }
}
